---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';

const base = import.meta.env.BASE_URL;
const github = 'https://github.com/ivangsm/jay';
const title = 'Jay — your own S3, in one binary';
const description =
  'Jay is open-source object storage you host yourself. Store files with the S3 API you already use, on your own server, with no database and nothing else to run.';

// The landing page sells the idea; the mechanics (frame layout, fsync order,
// status codes, benchmark tables) live in the docs. Keep jargon out of this file.

// The hero demo: the same upload through every door into the same store.
// `code` is pre-highlighted HTML; `copy` is what the Copy button puts on the
// clipboard, without prompts or output.
const demos = [
  {
    id: 'cli',
    label: 'AWS CLI',
    file: 'terminal',
    code: `<span class="p">$</span> export AWS_ENDPOINT_URL=http://localhost:9000
<span class="p">$</span> aws s3 mb s3://photos
<span class="o">make_bucket: photos</span>
<span class="p">$</span> aws s3 cp cat.jpg s3://photos/
<span class="o">upload: ./cat.jpg to s3://photos/cat.jpg</span>`,
    copy: `export AWS_ENDPOINT_URL=http://localhost:9000
aws s3 mb s3://photos
aws s3 cp cat.jpg s3://photos/`,
    note: 'Your existing S3 tools work unchanged. Only the endpoint is new.',
  },
  {
    id: 'python',
    label: 'Python',
    file: 'upload.py',
    code: `<span class="k">import</span> boto3

s3 = boto3.client(<span class="s">"s3"</span>, endpoint_url=<span class="s">"http://localhost:9000"</span>)
s3.create_bucket(Bucket=<span class="s">"photos"</span>)
s3.upload_file(<span class="s">"cat.jpg"</span>, <span class="s">"photos"</span>, <span class="s">"cat.jpg"</span>)`,
    copy: `import boto3

s3 = boto3.client("s3", endpoint_url="http://localhost:9000")
s3.create_bucket(Bucket="photos")
s3.upload_file("cat.jpg", "photos", "cat.jpg")`,
    note: 'boto3 and the AWS SDKs connect like they would to Amazon S3.',
  },
  {
    id: 'go',
    label: 'Go client',
    file: 'main.go',
    code: `<span class="c">// The native protocol: no HTTP, no XML, no re-hashing.</span>
c, err := client.Dial(ctx, <span class="s">"localhost:4444"</span>, tokenID, secret)
<span class="k">if</span> err != <span class="k">nil</span> { log.Fatal(err) }
<span class="k">defer</span> c.Close()

c.CreateBucket(ctx, <span class="s">"photos"</span>)
c.PutObject(ctx, <span class="s">"photos"</span>, <span class="s">"cat.jpg"</span>, f, size, <span class="k">nil</span>)`,
    copy: `c, err := client.Dial(ctx, "localhost:4444", tokenID, secret)
if err != nil { log.Fatal(err) }
defer c.Close()

c.CreateBucket(ctx, "photos")
c.PutObject(ctx, "photos", "cat.jpg", f, size, nil)`,
    note: 'From Go, a faster binary protocol on the same server and the same data.',
  },
  {
    id: 'embedded',
    label: 'Embedded',
    file: 'main.go',
    code: `<span class="c">// No server at all: the same engine, inside your program.</span>
s, err := jay.Open(<span class="s">"./data"</span>)
<span class="k">if</span> err != <span class="k">nil</span> { log.Fatal(err) }
<span class="k">defer</span> s.Close()

s.CreateBucket(ctx, <span class="s">"photos"</span>)
s.Put(ctx, <span class="s">"photos"</span>, <span class="s">"cat.jpg"</span>, f, <span class="k">nil</span>)`,
    copy: `s, err := jay.Open("./data")
if err != nil { log.Fatal(err) }
defer s.Close()

s.CreateBucket(ctx, "photos")
s.Put(ctx, "photos", "cat.jpg", f, nil)`,
    note: 'Or skip the server: import Jay as a Go package and keep it in-process.',
  },
];

const tools = ['AWS CLI', 'boto3', 'AWS SDKs', 'Go', 'Docker'];

const features = [
  {
    title: 'S3, without changing your code',
    body: 'Buckets, uploads, downloads, listings, multipart and presigned links all speak the S3 API. Point your app at a new endpoint and it keeps working.',
    icon: 'M7 18a5 5 0 1 1 .9-9.9A6 6 0 0 1 19 10a4 4 0 0 1 0 8z',
  },
  {
    title: 'Up to 5× faster from Go',
    body: 'Go services can use a lightweight binary protocol instead of HTTP. Same server, same files, a fraction of the overhead.',
    icon: 'M13 2 3 14h8l-1 8 10-12h-8l1-8z',
  },
  {
    title: 'Or embed it as a library',
    body: 'Import Jay into your Go program and get the whole storage engine in-process. No network, no tokens, nothing to deploy.',
    icon: 'M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8',
  },
  {
    title: 'Files that stay intact',
    body: 'Every object is checksummed on the way in and re-checked in the background. A crash mid-upload never leaves a half-written file behind.',
    icon: 'M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6zM9 12l2 2 4-4',
  },
  {
    title: 'Keys with exactly the access they need',
    body: 'Give each app or teammate its own key, limited to certain buckets, folders and actions. Share files with links that expire.',
    icon: 'M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4',
  },
  {
    title: 'Nothing else to run',
    body: 'No database, no message queue, no cluster. Everything Jay knows lives in one folder you can copy, inspect and back up.',
    icon: 'M3 6h6l2 2h10v11H3z',
  },
];

const extras = [
  'Multipart uploads',
  'Range reads',
  'Server-side copy',
  'Hourly metadata backups',
  'Health checks',
  'Metrics and JSON logs',
  'TLS',
  'Linux and macOS binaries',
];

// Time per request, lower is better. From the performance page.
const bench = [
  { label: 'Read a small file', s3: 81.3, native: 38.9, unit: 'µs', ratio: '2.1×' },
  { label: 'Look up a file’s details', s3: 59.8, native: 27.0, unit: 'µs', ratio: '2.2×' },
  { label: 'Small reads, 16 at once', s3: 26.3, native: 5.0, unit: 'µs', ratio: '5.2×' },
];

const useCases = [
  {
    title: 'Your app’s uploads',
    body: 'Avatars, attachments and documents, stored next to the app instead of on a third-party bill.',
    icon: 'M12 16V4M7 9l5-5 5 5M4 20h16',
  },
  {
    title: 'Build and CI caches',
    body: 'Fast, local artifact and cache storage that any S3-aware tool already knows how to use.',
    icon: 'M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5',
  },
  {
    title: 'Media backends',
    body: 'Photos and video for a site or an image server, served with range reads straight from disk.',
    icon: 'M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6',
  },
  {
    title: 'S3 for development and tests',
    body: 'A real S3 endpoint on your laptop and in CI, in one container that starts in seconds.',
    icon: 'M4 5h16v14H4zM8 10l2 2-2 2M13 14h3',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://ivangsm.github.io/jay/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ivangsm.github.io/jay/" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <a class="wordmark" href={base} aria-label="Jay home">
        <span class="mark" aria-hidden="true"></span>
        <span class="wordmark-text">jay</span>
      </a>
      <nav aria-label="Main">
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href={`${base}what-jay-is/`}>Docs</a>
        <a class="nav-gh" href={github} rel="noopener">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Open-source object storage</p>
          <h1>Your own S3.<br /><span>In one binary.</span></h1>
          <p class="lede">
            Jay stores your files behind the same S3 API your tools already
            speak — on your own server, with no database and nothing else to
            run. Start it in a minute, keep it for years.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`${base}quickstart/`}>Get started</a>
            <a class="btn" href={github} rel="noopener">View on GitHub</a>
          </div>
          <p class="fine">Free and open source (MIT) · No database to set up · Linux and macOS</p>
        </div>

        <figure class="demo" data-demo>
          <div class="demo-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="tabs" role="tablist" aria-label="Ways to talk to Jay">
              {demos.map((d, i) => (
                <button
                  type="button"
                  role="tab"
                  class="tab"
                  id={`tab-${d.id}`}
                  aria-controls={`panel-${d.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {d.label}
                </button>
              ))}
            </div>
          </div>
          {demos.map((d, i) => (
            <div
              class="panel"
              role="tabpanel"
              id={`panel-${d.id}`}
              aria-labelledby={`tab-${d.id}`}
              hidden={i !== 0}
            >
              <div class="panel-head">
                <span class="file">{d.file}</span>
                <button type="button" class="copy" data-copy={d.copy}>Copy</button>
              </div>
              <pre><code set:html={d.code} /></pre>
              <p class="panel-note">{d.note}</p>
            </div>
          ))}
          <figcaption>One store, four ways in. Every one of them reaches the same buckets.</figcaption>
        </figure>
      </section>

      <section class="tools" aria-label="Works with">
        <p>Works with the tools you already use</p>
        <ul>
          {tools.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <section class="section" id="how">
        <p class="kicker">How it works</p>
        <h2>From nothing to a stored file in about a minute.</h2>
        <p class="section-lede">
          No cluster to plan, no database to provision, no migrations. One
          container and a folder for your data.
        </p>
        <ol class="steps">
          <li>
            <span class="step-n">1</span>
            <h3>Start one container</h3>
            <p>Give it a volume and two secrets. That is the whole setup.</p>
            <code class="step-code">docker run … ghcr.io/ivangsm/jay</code>
          </li>
          <li>
            <span class="step-n">2</span>
            <h3>Create a key</h3>
            <p>Mint a key for your app and choose exactly what it is allowed to do.</p>
            <code class="step-code">POST /_jay/tokens</code>
          </li>
          <li>
            <span class="step-n">3</span>
            <h3>Point your S3 client at it</h3>
            <p>Change the endpoint in your app or CLI. Everything else stays the same.</p>
            <code class="step-code">--endpoint-url http://localhost:9000</code>
          </li>
        </ol>
      </section>

      <section class="section" id="features">
        <p class="kicker">Features</p>
        <h2>Everything you need from object storage. Nothing you have to babysit.</h2>
        <div class="grid">
          {features.map((f) => (
            <article class="card">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={f.icon} /></svg>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
        <ul class="extras" aria-label="Also included">
          {extras.map((e) => <li>{e}</li>)}
        </ul>
      </section>

      <section class="section speed">
        <div class="speed-copy">
          <p class="kicker">Performance</p>
          <h2>Fast over S3. Faster over its own protocol.</h2>
          <p class="section-lede">
            Reads go straight from disk to the network without passing through
            the program. And when the caller is Go, the native protocol drops
            HTTP and XML altogether — the busier the server, the bigger the gap.
          </p>
          <a class="more" href={`${base}internals/performance/`}>See every benchmark and how to reproduce it →</a>
        </div>
        <figure class="bars">
          <figcaption>
            Time per request, lower is better
            <span class="legend"><i class="sw sw-s3"></i>S3 API <i class="sw sw-native"></i>Native</span>
          </figcaption>
          {bench.map((b) => (
            <div class="bar-row">
              <div class="bar-label">
                <span>{b.label}</span>
                <b>{b.ratio} faster</b>
              </div>
              <div class="bar" style="--v:1">
                <span class="bar-fill s3"></span>
                <span class="bar-val">{b.s3.toFixed(1)} {b.unit}</span>
              </div>
              <div class="bar" style={`--v:${b.native / b.s3}`}>
                <span class="bar-fill native"></span>
                <span class="bar-val">{b.native.toFixed(1)} {b.unit}</span>
              </div>
            </div>
          ))}
          <p class="bars-foot">Measured on a 16-thread Ryzen 7 desktop.</p>
        </figure>
      </section>

      <section class="section">
        <p class="kicker">Made for</p>
        <h2>Anywhere you would reach for S3.</h2>
        <div class="uses">
          {useCases.map((u) => (
            <article class="use">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={u.icon} /></svg>
              <div>
                <h3>{u.title}</h3>
                <p>{u.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section why">
        <p class="kicker">Why Jay</p>
        <h2>Small on purpose. Honest about it.</h2>
        <div class="why-grid">
          <div>
            <h3>You own everything</h3>
            <p>
              Your files live on your disk, in a folder you can see. No
              per-request bill, no egress fees, no lock-in.
            </p>
          </div>
          <div>
            <h3>No silent surprises</h3>
            <p>
              If Jay does not support something, it says so with a clear error.
              It never pretends a request worked and quietly drops your data.
            </p>
          </div>
          <div>
            <h3>Know where it stops</h3>
            <p>
              One server, not a cluster: no replication or versioning. If you
              need those, Jay will tell you upfront instead of half-doing them.
            </p>
          </div>
        </div>
        <p class="why-links">
          <a href={`${base}what-jay-is/`}>What Jay is, and is not →</a>
          <a href={`${base}reference/s3-compatibility/`}>Full S3 compatibility list →</a>
        </p>
      </section>

      <section class="cta">
        <div class="cta-inner">
          <h2>Run your own S3 in about a minute.</h2>
          <p>
            One container, two secrets, a volume. Try it on your laptop today
            and move it to production when you are ready.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`${base}quickstart/`}>Get started</a>
            <a class="btn" href={github} rel="noopener">Star on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <p>MIT licensed. Built by <a href="https://github.com/ivangsm" rel="noopener">Iván Salazar</a>.</p>
      <nav aria-label="Footer">
        <a href={`${base}quickstart/`}>Quickstart</a>
        <a href={`${base}what-jay-is/`}>Docs</a>
        <a href={`${base}reference/s3-compatibility/`}>S3 API</a>
        <a href={`${base}internals/limits/`}>Limits</a>
        <a href={github} rel="noopener">GitHub</a>
      </nav>
    </footer>

    <script>
      const demo = document.querySelector('[data-demo]');
      if (demo) {
        const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const select = (tab: HTMLButtonElement) => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
            if (panel) panel.hidden = !on;
          });
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => select(tab));
          tab.addEventListener('keydown', (e) => {
            const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
            if (!step) return;
            const next = tabs[(i + step + tabs.length) % tabs.length];
            select(next);
            next.focus();
          });
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
            btn.textContent = 'Copied';
          } catch {
            btn.textContent = 'Press ⌘C';
          }
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });
      });
    </script>
  </body>
</html>

<style>
	:root {
		--navy: #071a33;
		--navy-2: #0c2445;
		--navy-3: #12325c;
		--blue: #2e7de9;
		--blue-bright: #4a90f0;
		--blue-deep: #1f63cb;
		--sky: #7fc4e8;
		--tan: #ebca9a;
		--paper: #f2f6fb;
		--text-2: #c3d2e6;
		--muted: #93a8c4;
		--line: #1b3559;
		--code-bg: #061529;
		--radius: 14px;
		--wrap: 1140px;
		color-scheme: dark;
	}

	* { box-sizing: border-box; }

	html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

	body {
		margin: 0;
		background: var(--navy);
		color: var(--paper);
		font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
		font-size: 16px;
		line-height: 1.6;
		overflow-x: hidden;
	}

	a { color: var(--sky); text-decoration-thickness: 1px; text-underline-offset: 3px; }
	a:hover { color: var(--paper); }
	code, pre { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
	h1, h2, h3 { font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; text-wrap: balance; }

	:focus-visible { outline: 2px solid var(--sky); outline-offset: 3px; }

	.skip {
		position: absolute; left: -9999px;
		background: var(--paper); color: var(--navy); padding: 0.5rem 1rem;
	}
	.skip:focus { left: 1rem; top: 1rem; z-index: 10; }

	/* ---------- top bar ---------- */
	.topbar {
		display: flex; align-items: center; justify-content: space-between;
		gap: 1rem 2rem; flex-wrap: wrap;
		max-width: var(--wrap); margin: 0 auto; padding: 1.25rem 1.5rem;
	}
	.wordmark { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--paper); }
	.wordmark-text { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.04em; }
	/* Placeholder for the mascot: swapping in the artwork means replacing this rule. */
	.mark {
		width: 28px; height: 28px; flex: none;
		background:
			linear-gradient(150deg, var(--sky) 0 50%, transparent 50%),
			linear-gradient(30deg, var(--blue) 0 50%, #1a5cbe 50%);
		border-radius: 6px;
	}
	.topbar nav { display: flex; align-items: center; gap: 1.5rem; font-size: 0.9375rem; flex-wrap: wrap; }
	.topbar nav a { color: var(--muted); text-decoration: none; }
	.topbar nav a:hover { color: var(--paper); }
	.topbar nav .nav-gh {
		color: var(--paper); border: 1px solid var(--navy-3); border-radius: 999px;
		padding: 0.3rem 0.9rem;
	}
	.topbar nav .nav-gh:hover { border-color: var(--blue); }

	/* ---------- hero ---------- */
	.hero {
		position: relative;
		max-width: var(--wrap); margin: 0 auto; padding: 4.5rem 1.5rem 4rem;
		display: grid; grid-template-columns: 1fr 1.05fr; gap: 4rem; align-items: center;
	}
	.hero::before {
		content: ''; position: absolute; z-index: -1; pointer-events: none;
		width: min(760px, 100%); aspect-ratio: 1; right: 0; top: -220px;
		background: radial-gradient(closest-side, rgba(46, 125, 233, 0.3), transparent);
	}
	.hero-copy { min-width: 0; }
	.eyebrow, .kicker {
		margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 600;
		letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky);
	}
	.hero h1 {
		font-size: clamp(2.4rem, 5.4vw, 4rem);
		letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 1.5rem;
	}
	.hero h1 span {
		background: linear-gradient(90deg, var(--sky), var(--blue-bright));
		-webkit-background-clip: text; background-clip: text; color: transparent;
	}
	.lede { font-size: 1.1875rem; color: var(--text-2); margin: 0 0 2rem; max-width: 46ch; }
	.fine { margin: 1.5rem 0 0; font-size: 0.875rem; color: var(--muted); }

	.actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
	.btn {
		display: inline-block; padding: 0.75rem 1.4rem;
		border: 1px solid var(--navy-3); border-radius: 999px;
		color: var(--paper); text-decoration: none; font-size: 0.9875rem; font-weight: 600;
		transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}
	.btn:hover { background: var(--navy-2); border-color: var(--blue); color: var(--paper); transform: translateY(-1px); }
	.btn-primary { background: var(--blue-deep); border-color: var(--blue-deep); }
	.btn-primary:hover { background: var(--blue); border-color: var(--blue); }

	/* ---------- hero demo ---------- */
	.demo {
		margin: 0; min-width: 0;
		background: var(--navy-2); border: 1px solid var(--line);
		border-radius: var(--radius); overflow: hidden;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.75);
	}
	.demo-bar {
		display: flex; align-items: center; gap: 0.9rem;
		padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--line);
	}
	.dots { display: flex; gap: 6px; flex: none; }
	.dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--navy-3); }
	.tabs { display: flex; gap: 0.35rem; overflow-x: auto; scrollbar-width: none; min-width: 0; }
	.tabs::-webkit-scrollbar { display: none; }
	.tab {
		font: inherit; font-size: 0.8125rem; cursor: pointer; white-space: nowrap;
		background: transparent; color: var(--muted);
